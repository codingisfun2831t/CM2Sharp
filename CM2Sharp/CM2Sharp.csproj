<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>CM2Sharp</Title>
    <Authors>codingisfun2831t</Authors>
    <Company />
    <Description>C# library for saving/loading Circuit Maker 2 save files</Description>
    <Copyright>Copyright (C) codingisfun2831t 2026</Copyright>
    <PackageProjectUrl>https://github.com/codingisfun2831t/CM2Sharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/codingisfun2831t/CM2Sharp</RepositoryUrl>
    <PackageTags>cm2;lib</PackageTags>
    <PackageReleaseNotes>Initial release</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
